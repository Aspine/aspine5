---
import Page from "../layouts/Page.astro";
import { sessionLive } from "../server/session";
import "../styles/login.scss";

export const prerender = false;

const signedIn = sessionLive(Astro.cookies.get("aspineSession")?.value);
---

<Page>
	<main class="loginPage">
		<div class="loginPanel">
			<h1 class="loginTitle">Not found</h1>
			<a class="button primary" href={signedIn ? "/home" : "/"}>
				{signedIn ? "Home" : "Sign in"}
			</a>
		</div>
	</main>
</Page>
