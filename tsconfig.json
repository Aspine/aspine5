{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "references", "node_modules"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"types": ["bun"],
		"noPropertyAccessFromIndexSignature": false,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
